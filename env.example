# Instagram Reels Scraper 환경 변수
# cp env.example .env 후 값을 채워서 사용
# 계정별 설정은 accounts.yaml 에서 관리 (--profile kr / --profile jp)

# =====================
# 인스타그램 로그인
# accounts.yaml --profile 사용 시 아래 값은 무시됨
# =====================
INSTAGRAM_USERNAME=your_username
INSTAGRAM_PASSWORD=your_password

# =====================
# 숏트렌드 로그인
# =====================
SHORTREND_EMAIL=your_email@example.com
SHORTREND_PASSWORD=your_password

# =====================
# 스크래핑 대상
# =====================
HASHTAG=
TARGET_URL=

# =====================
# 출력 설정
# =====================
OUTPUT_DIR=output
# json 또는 csv
OUTPUT_FORMAT=json

# =====================
# Playwright 브라우저
# =====================
# true: 창 없이 실행 (서버환경), false: 창 띄워서 실행
PLAYWRIGHT_HEADLESS=false
# 요소 대기 타임아웃 (밀리초)
PLAYWRIGHT_TIMEOUT=30000
# chromium / firefox / webkit
PLAYWRIGHT_BROWSER=chromium
# 쿠키/세션 파일 경로 (선택)
# PLAYWRIGHT_STORAGE_STATE=output/browser_state.json

# =====================
# 브라우저 로케일
# accounts.yaml --profile 사용 시 해당 프로파일 값으로 덮어씌워짐
# =====================
# ko-KR, ja-JP, en-US 등
BROWSER_LOCALE=ko-KR
# Asia/Seoul, Asia/Tokyo, America/New_York 등
BROWSER_TIMEZONE=Asia/Seoul

# =====================
# 프록시 (선택)
# =====================
# PROXY_SERVER=http://proxy.example.com:8080
# PROXY_USERNAME=your_proxy_username
# PROXY_PASSWORD=your_proxy_password

# =====================
# 스크래핑 제한
# =====================
# 비워두면 무제한
MAX_REELS=
# 요청 간 딜레이 (초) - 너무 낮추면 IP 차단 위험
REQUEST_DELAY=2.0

# =====================
# 로깅
# =====================
# DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO
# 비워두면 콘솔만 출력
LOG_FILE=

# =====================
# 세션 관리
# =====================
# db: DB에 세션 저장 / file: 파일로 저장
SESSION_STORAGE_TYPE=file
# file 타입일 때 세션 파일 저장 디렉토리
SESSION_FILE_DIR=sessions

# =====================
# 데이터베이스 (선택)
# DB_ENABLED=false 로 두면 DB 없이 파일 저장만 사용
# =====================
DB_ENABLED=false
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=instagram_reels_scraper
DB_USER=dbmasteruser
DB_PASSWORD=your_db_password
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
